{
  "configVersion": "2.0",
  "$schema": "https://github.com/jayu/rev-dep/blob/master/config-schema/2.0.schema.json?raw=true",
  "nodeModulesResolution": {
    "resolutionType": "entry-package",
    "includeDevDepsFromRoot": false,
  },
  "ignoreFiles": [
    // A separate project with its own package.json and lockfile. Its imports
    // (benchmarkify, validator-fns) resolve only inside benchmark/, so rev-dep
    // reports them as missing and the file as an orphan.
    "benchmark/**",
    // The published RunKit example. It imports the package by name, which
    // rev-dep can't resolve, and nothing imports it.
    "runkit.cjs",
  ],
  "workspaces": [
    {
      "path": ".",
      "prodEntryPoints": ["src/index.ts", "src/en.ts"],
      "devEntryPoints": [
        "test/**/*.test.ts",
        "*.config.{ts,mjs}",
        "scripts/*.mjs",
      ],
      // The layout decided in #744. Imports flow one way: types.ts, then
      // failures/, results.ts, pipeline/, the type modules and tests, plus
      // parse.ts and coerce.ts, and index.ts last. A folder imports anything
      // inside itself, and from outside only its index.ts is imported. Every
      // other file lists exactly what it imports.
      "moduleBoundaries": [
        {
          // The public types. No runtime code.
          "name": "types",
          "pattern": "src/types.ts",
          "deny": ["src/**"],
        },
        {
          // Types copied from @standard-schema/spec, with no imports.
          "name": "standard-schema",
          "pattern": "src/standard-schema.ts",
          "deny": ["src/**"],
        },
        {
          "name": "parse-date",
          "pattern": "src/parse-date.ts",
          "deny": ["src/**"],
        },
        {
          // Makes and words failures.
          "name": "failures",
          "pattern": "src/failures/**",
          "allow": [
            "src/types.ts",
            "src/standard-schema.ts",
            "src/failures/**",
          ],
        },
        {
          "name": "results",
          "pattern": "src/results.ts",
          "allow": ["src/types.ts", "src/failures/index.ts"],
        },
        {
          // The type-validator pipeline.
          "name": "pipeline",
          "pattern": "src/pipeline/**",
          "allow": [
            "src/types.ts",
            "src/standard-schema.ts",
            "src/failures/index.ts",
            "src/results.ts",
            "src/pipeline/**",
          ],
        },
        {
          // Only standard.ts, the pipeline's Standard Schema support, imports
          // the Standard Schema types. rev-dep's patterns can't exclude a
          // file, so this lists every other pipeline file; add new ones here.
          "name": "pipeline-core",
          "pattern": "src/pipeline/{children,config,def,factory,gates,index,items,messages,nesting,optional,present,promises,properties,run,schema,steps,sync,tests,twins}.ts",
          "deny": ["src/standard-schema.ts"],
        },
        {
          "name": "valid-date",
          "pattern": "src/valid-date.ts",
          "deny": ["src/**"],
        },
        {
          "name": "type-validators",
          "pattern": "src/{arrays,booleans,limits,numbers,objects,strings}.ts",
          "allow": ["src/types.ts", "src/pipeline/index.ts"],
        },
        {
          "name": "dates",
          "pattern": "src/dates.ts",
          "allow": [
            "src/types.ts",
            "src/pipeline/index.ts",
            "src/parse-date.ts",
            "src/valid-date.ts",
          ],
        },
        {
          "name": "common",
          "pattern": "src/common.ts",
          "allow": [
            "src/types.ts",
            "src/results.ts",
            "src/pipeline/index.ts",
            "src/valid-date.ts",
          ],
        },
        {
          "name": "check",
          "pattern": "src/check.ts",
          "allow": ["src/types.ts", "src/failures/index.ts", "src/results.ts"],
        },
        {
          "name": "parse",
          "pattern": "src/parse.ts",
          "allow": ["src/types.ts", "src/failures/index.ts"],
        },
        {
          // Only the coerce namespace; each twin lives in its type's module.
          "name": "coerce",
          "pattern": "src/coerce.ts",
          "allow": ["src/{booleans,dates,numbers}.ts"],
        },
        {
          "name": "entry",
          "pattern": "src/index.ts",
          "allow": [
            "src/{arrays,booleans,check,coerce,common,dates,limits,numbers,objects,parse,results,strings,types}.ts",
            "src/failures/index.ts",
            "src/pipeline/index.ts",
          ],
        },
        {
          // The validator-fns/en subpath: the English translation.
          "name": "en",
          "pattern": "src/en.ts",
          "allow": ["src/types.ts", "src/en-amount.ts"],
        },
        {
          "name": "en-amount",
          "pattern": "src/en-amount.ts",
          "allow": ["src/types.ts", "src/failures/index.ts"],
        },
        {
          "name": "tests",
          "pattern": "test/**/*",
          "allow": ["src/index.ts", "src/en.ts"],
        },
      ],
      "restrictedImportsDetection": {
        "enabled": true,
        "entryPoints": ["src/index.ts", "src/en.ts"],
        "denyModules": ["*"],
      },
      "circularImportsDetection": { "enabled": true },
      "orphanFilesDetection": { "enabled": true },
      "unusedExportsDetection": { "enabled": true },
      "unusedNodeModulesDetection": {
        "enabled": true,
        "pkgJsonFieldsWithBinaries": ["scripts"],
        "excludeModules": [
          "@types/node",
          "@vitest/coverage-v8",
          "oxlint-tsgolint",
          // Stryker loads it by the name in stryker.config.mjs's plugins, which
          // rev-dep doesn't read as a use. Approved in #634. Remove it if rev-dep
          // starts to, or if Stryker stops needing the plugin named (see
          // stryker.config.mjs).
          "@stryker-mutator/vitest-runner",
        ],
      },
      "missingNodeModulesDetection": { "enabled": true },
      "unresolvedImportsDetection": { "enabled": true },
      "devDepsUsageOnProdDetection": { "enabled": true },
      "duplicatedCodeDetection": { "enabled": true },
    },
  ],
}
