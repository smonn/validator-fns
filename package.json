{
  "name": "validator-fns",
  "version": "3.0.0-next.0",
  "description": "Small asynchronous validation library",
  "license": "MIT",
  "files": [
    "dist",
    "runkit.cjs"
  ],
  "author": {
    "name": "Simon Ingeson",
    "url": "https://smonn.se"
  },
  "keywords": [
    "async",
    "browser",
    "browsers",
    "function",
    "functional",
    "functions",
    "isomorphic",
    "node",
    "promise",
    "ssr",
    "typescript",
    "universal",
    "validate",
    "validation",
    "validator"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "typings": "./dist/index.d.ts",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.18.0",
      "onFail": "error"
    }
  },
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "build": "tsdown",
    "check": "run-s changeset:status check:code",
    "check:code": "run-s ignores format:check lint typecheck deps fta coverage build publint attw smoke bench:smoke",
    "changeset:status": "node scripts/changeset-status.mjs",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "ignores": "node scripts/check-ignores.mjs",
    "lint": "oxlint --deny-warnings",
    "lint:staged": "lint-staged",
    "typecheck": "tsc --noEmit",
    "deps": "rev-dep config run",
    "fta": "node scripts/fta-check.mjs",
    "fta:update": "node scripts/fta-check.mjs --update",
    "publint": "publint --strict",
    "attw": "attw --pack .",
    "smoke": "node scripts/smoke-test.mjs",
    "bench:smoke": "pnpm --dir benchmark install --frozen-lockfile && node benchmark/index.mjs --smoke",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "prepublishOnly": "pnpm check",
    "prepare": "husky"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "3.0.3",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "fta-cli": "3.0.1",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "npm-run-all": "4.1.5",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2003",
    "publint": "0.3.25",
    "rev-dep": "3.1.0",
    "tsdown": "0.23.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "repository": "github:smonn/validator-fns",
  "homepage": "https://validator-fns.smonn.se/",
  "runkitExampleFilename": "runkit.cjs"
}
