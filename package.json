{
  "name": "validator-fns",
  "version": "2.0.1",
  "description": "Small asynchronous validation library",
  "license": "MIT",
  "files": [
    "dist",
    "runkit.js"
  ],
  "author": {
    "name": "Simon Ingeson",
    "url": "https://smonn.se"
  },
  "keywords": [
    "async",
    "browser",
    "browsers",
    "function",
    "functional",
    "functions",
    "isomorphic",
    "node",
    "promise",
    "ssr",
    "typescript",
    "universal",
    "validate",
    "validation",
    "validator"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "typings": "./dist/index.d.ts",
  "sideEffects": false,
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "tsup",
    "check": "run-s format:check lint typecheck deps fta coverage build publint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc --noEmit",
    "deps": "rev-dep config run",
    "fta": "fta src --score-cap 62",
    "publint": "publint --strict",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "prepublishOnly": "pnpm check",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "20.12.12",
    "@vitest/coverage-v8": "1.6.0",
    "fta-cli": "3.0.1",
    "husky": "9.0.11",
    "lint-staged": "15.2.2",
    "npm-run-all": "4.1.5",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2003",
    "publint": "0.3.25",
    "rev-dep": "3.1.0",
    "tsup": "8.0.2",
    "typescript": "5.4.5",
    "vitest": "1.6.0"
  },
  "repository": "github:smonn/validator-fns",
  "homepage": "https://validator-fns.smonn.se/",
  "runkitExampleFilename": "runkit.js",
  "lint-staged": {
    "*.ts": "oxlint --fix --deny-warnings",
    "*.{ts,js,json,jsonc,md,yml,yaml}": "oxfmt --no-error-on-unmatched-pattern"
  }
}
